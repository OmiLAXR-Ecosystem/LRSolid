PG_DSN=postgres://lrsolid:lrsolid@localhost:5433/lrsolid?sslmode=disable
DEFAULT_ORG=default

# Auth — generate a strong secret for production:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# Public origin of the web UI. SSO redirect URIs are built from this.
APP_URL=http://localhost:5174

# Password login for the default organisation. Unset leaves the database value alone.
# LOCAL_LOGIN_ENABLED=true

# OpenID Connect seed (applied once, when OIDC_SLUG is not already configured).
# Requires DATA_STORE_SECRET_KEY when OIDC_CLIENT_SECRET is set.
# OIDC_ENABLED=false
# OIDC_SLUG=oidc
# OIDC_DISPLAY_NAME=University SSO
# OIDC_ISSUER=https://idp.example.edu/realms/main
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# OIDC_AUTO_PROVISION=false
# OIDC_DEFAULT_ROLE=viewer

# SAML 2.0 / Shibboleth seed (applied once). A SP key is generated if the files are empty.
# SAML_ENABLED=false
# SAML_SLUG=shibboleth
# SAML_DISPLAY_NAME=Shibboleth
# SAML_IDP_METADATA_URL=https://idp.example.edu/idp/shibboleth
# SAML_SP_ENTITY_ID=
# SAML_SP_CERT_FILE=
# SAML_SP_KEY_FILE=
# SAML_AUTO_PROVISION=false
# SAML_DEFAULT_ROLE=viewer

# Async stats rollup job (updates statement_count + daily stats in batches)
STATS_ROLLUP_ENABLED=true
STATS_ROLLUP_INTERVAL_S=15
STATS_ROLLUP_BATCH_SIZE=5000

# Export defaults
EXPORT_DEFAULT_TARGET_TYPE=s3
EXPORT_S3_UPLOAD_BASE_URL=
EXPORT_S3_PUBLIC_BASE_URL=
EXPORT_S3_AUTH_TOKEN=
EXPORT_S3_PATH_PREFIX=exports
