PG_DSN=postgres://postgres:postgres@localhost:5432/lrsolid?sslmode=disable
DEFAULT_ORG=default

# Auth — generate a strong secret for production:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# Async stats rollup job (updates statement_count + daily stats in batches)
STATS_ROLLUP_ENABLED=true
STATS_ROLLUP_INTERVAL_S=15
STATS_ROLLUP_BATCH_SIZE=5000
