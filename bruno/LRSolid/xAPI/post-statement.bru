meta {
  name: xAPI Post Statement
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/xapi/statements
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{sessionCookie}}
  X-Experience-API-Version: 1.0.3
}

body:json {
  {
    "statement": {
      "actor": {
        "mbox": "mailto:sergej@example.org"
      },
      "verb": {
        "id": "http://adlnet.gov/expapi/verbs/experienced",
        "display": {
          "en-US": "experienced"
        }
      },
      "object": {
        "id": "https://example.org/activity/intro"
      }
    }
  }
}

settings {
  encodeUrl: true
  followRedirects: true
}
