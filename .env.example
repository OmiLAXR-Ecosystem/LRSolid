PG_DSN=postgres://lrsolid:lrsolid@localhost:5433/lrsolid?sslmode=disable
DEFAULT_ORG=default

# Auth — generate a strong secret for production:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# Async stats rollup job (updates statement_count + daily stats in batches)
STATS_ROLLUP_ENABLED=true
STATS_ROLLUP_INTERVAL_S=15
STATS_ROLLUP_BATCH_SIZE=5000

# Export defaults
EXPORT_DEFAULT_TARGET_TYPE=s3
EXPORT_S3_UPLOAD_BASE_URL=
EXPORT_S3_PUBLIC_BASE_URL=
EXPORT_S3_AUTH_TOKEN=
EXPORT_S3_PATH_PREFIX=exports
